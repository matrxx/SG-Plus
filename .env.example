# =============================================================================
# Configuration de Nestor-C2 — Portail de Services Internes
# =============================================================================
# Copiez ce fichier en .env et renseignez les valeurs pour votre environnement.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données PostgreSQL
# -----------------------------------------------------------------------------
# Format: postgresql://utilisateur:motdepasse@hote:port/base_de_donnees
DATABASE_URL=postgresql://portail_user:portail_password@localhost:5432/nestor_c2

# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------
# Clé secrète pour le chiffrement des sessions (générez-en une avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=votre_clé_sécrète_ici_changer_la_obligatoirement

# -----------------------------------------------------------------------------
# Authentification
# -----------------------------------------------------------------------------
# Domaine(s) e-mail autorisé(s) pour l'inscription (séparés par des virgules)
ALLOWED_EMAIL_DOMAIN=mon-entreprise.com

# -----------------------------------------------------------------------------
# Réseau
# -----------------------------------------------------------------------------
# Plages IP autorisées à accéder au portail (format CIDR, séparées par des virgules)
# Exemples: 10.0.0.0/8, 192.168.0.0/16, 172.16.0.0/12
# Pour le développement local, ajoutez: 127.0.0.1/32
ALLOWED_IP_RANGES=10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# URL publique du portail (utilisée dans les e-mails)
PUBLIC_BASE_URL=http://localhost:3000

# Port du serveur (par défaut: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# SMTP (envoi d'e-mails)
# -----------------------------------------------------------------------------
# Hôte SMTP
SMTP_HOST=smtp.mon-entreprise.com

# Port SMTP (587 pour STARTTLS, 465 pour SSL/TLS)
SMTP_PORT=587

# Utilisateur SMTP (si authentification requise)
SMTP_USER=portail@mon-entreprise.com

# Mot de passe SMTP (si authentification requise)
SMTP_PASSWORD=votre_mot_de_passe_smtp

# Utiliser une connexion sécurisée (true pour le port 465, false pour 587)
SMTP_SECURE=false

# Adresse e-mail de l'expéditeur (par défaut: SMTP_USER).
# Avec un compte de service + boîte partagée : mettre ici l'adresse de la boîte
# partagée (le compte de service doit avoir le droit "Send As" dessus).
SMTP_FROM=portail@mon-entreprise.com

# Nom affiché de l'expéditeur (par défaut: Nestor-C2)
SMTP_FROM_NAME=Nestor-C2

# Adresse de réponse (optionnel, ex. un contact support surveillé)
# SMTP_REPLY_TO=

# Exiger STARTTLS (true recommandé avec Microsoft 365 sur le port 587)
SMTP_REQUIRE_TLS=false

# Rejeter les certificats invalides. Laisser true (ou absent) avec Microsoft 365 ;
# false uniquement pour un serveur interne à certificat auto-signé.
SMTP_REJECT_UNAUTHORIZED=true

# -----------------------------------------------------------------------------
# MODE TEST : bouton « TEST » sur la page de connexion
# -----------------------------------------------------------------------------
# ⚠ Quand ALLOW_TEST_BYPASS=true, un bouton « TEST » ouvre une session SANS mot
# de passe, pour tester l'application. À laisser sur false (ou absent) sur tout
# serveur réel : toute personne qui atteint le serveur pourrait entrer.
ALLOW_TEST_BYPASS=false
# Rôle du compte de test : agent | validator | admin | superAdmin (défaut : agent)
TEST_BYPASS_ROLE=agent

# -----------------------------------------------------------------------------
# Destinataires des demandes (une ou plusieurs adresses, séparées par , ou ;)
# -----------------------------------------------------------------------------
# Objet de chaque e-mail : "<Catégorie> - <Formulaire>"
#   ex. "Intervention technique - Ascenseur / Monte charges"
# Tant qu'une adresse est vide, les demandes concernées sont enregistrées mais
# AUCUN e-mail ne part (statut "not_configured", renvoi possible par l'admin).

# Maintenance, ménage, livraison, manutention, véhicule
# (par défaut : c2rmf.technique@culture.gouv.fr)
MAIL_TECHNIQUE=c2rmf.technique@culture.gouv.fr
# Demandes de badge (création, modification, perte)
MAIL_RH=
# Perte de badge (en plus de MAIL_RH)
MAIL_ACCUEIL=
# Équipements de bureau
MAIL_EQUIPEMENTS=
# Livraison / enlèvement au quai
MAIL_QUAI=
# Accès externes (accès valise, prestataires), clés
MAIL_ACCES=
# Toute demande sans destinataire dédié (arrivée/départ, événementiel…)
MAIL_DEFAUT=

# Envoi d'un document PDF/Word à une adresse saisie librement (étape Validation).
# Vide = toute adresse acceptée. Pour restreindre (recommandé si le risque
# d'envoi vers l'extérieur n'est pas souhaité) : domaines séparés par des virgules.
#   ex. DOCUMENT_MAIL_ALLOWED_DOMAINS=culture.gouv.fr
DOCUMENT_MAIL_ALLOWED_DOMAINS=

# -----------------------------------------------------------------------------
# HTTPS
# -----------------------------------------------------------------------------
# Activer HTTPS (true/false)
USE_HTTPS=false

# Chemin vers la clé TLS (requis si USE_HTTPS=true)
TLS_KEY_PATH=/etc/ssl/private/portail.key

# Chemin vers le certificat TLS (requis si USE_HTTPS=true)
TLS_CERT_PATH=/etc/ssl/certs/portail.crt

# -----------------------------------------------------------------------------
# PostgreSQL SSL
# -----------------------------------------------------------------------------
# Activer SSL pour la connexion à PostgreSQL (true/false)
# Utile si votre serveur PostgreSQL utilise un certificat auto-signé
PGSSL=false

# -----------------------------------------------------------------------------
# Environnement
# -----------------------------------------------------------------------------
# Environnement d'exécution (development, production)
NODE_ENV=development
